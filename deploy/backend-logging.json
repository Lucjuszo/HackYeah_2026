{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {"format": "%(asctime)s %(levelname)s %(name)s: %(message)s"}
  },
  "handlers": {
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "/logs/backend/backend.log",
      "maxBytes": 2097152,
      "backupCount": 3,
      "encoding": "utf-8",
      "formatter": "default"
    },
    "console": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "default"
    }
  },
  "root": {"level": "WARNING", "handlers": ["file", "console"]},
  "loggers": {
    "uvicorn": {"level": "WARNING", "handlers": [], "propagate": true},
    "uvicorn.error": {"level": "WARNING", "handlers": [], "propagate": true},
    "uvicorn.access": {"level": "WARNING", "handlers": [], "propagate": true}
  }
}
