# Copy to backend.env on the Pi (never commit the real one). Replace example.com (frontend) / api.example.com (API)
# with the tunnel's public hostnames. Every setting: .env.example in the repo root.

# --- MongoDB Atlas (Network Access must allow the Pi's public IP)
USE_REMOTE_MONGO=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB=hackyeah

# --- Addresses
CORS_ORIGINS=https://example.com
CORS_ALLOW_LOCALHOST=false
PUBLIC_BASE_URL=https://api.example.com
TIMEZONE=Europe/Warsaw

# --- Auth. JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
AUTH_DEV_LOGIN=false
# Callbacks registered at the providers: https://api.example.com/auth/{github,google}/callback
OAUTH_CALLBACK_BASE_URL=https://api.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# New places from non-admins stay hidden until an admin approves them in the admin panel.
PLACES_REQUIRE_APPROVAL=true

# --- Photos on the Pi, in the `media` volume, served by the backend at https://api.example.com/media/...
STORAGE_BACKEND=local
