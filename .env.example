# Remote MongoDB (default). Set USE_REMOTE_MONGO=false to use the docker compose container instead.
USE_REMOTE_MONGO=true
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"
# Only used when MONGODB_URI has no credentials in it.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Local container (docker compose up -d)
MONGO_URI=mongodb://root:example@localhost:27017

MONGO_DB=hackyeah

# --- Frontend (docs/FRONTEND.md)
# Origins allowed to call the API from a browser, comma-separated (Vite 5173, Next/CRA 3000).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Plus localhost / 127.0.0.1 on any port (flutter run -d chrome uses a random one). false in production.
CORS_ALLOW_LOCALHOST=true
# Public address of this API: photo URLs become absolute, usable in <img src> on another origin.
PUBLIC_BASE_URL=http://localhost:8000
# Zone of places' opening hours (open_now).
TIMEZONE=Europe/Warsaw
# Per-user limits (0 = off).
PHOTO_UPLOADS_PER_HOUR=30

# --- Photos: Cloudinary (photos survive redeploys). Without credentials they go to the local media/ dir.
# Cloudinary -> Dashboard: either the whole "API environment variable"...
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three parts:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder in the Media Library.
CLOUDINARY_FOLDER=focusmap
# auto (Cloudinary when configured) | local | cloudinary
STORAGE_BACKEND=auto
COMMENTS_PER_HOUR=60

# --- Auth (docs/AUTH.md)
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=1440
# GitHub: Settings -> Developer settings -> OAuth Apps; callback http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application);
# redirect URI http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public API origin used to build /auth/{provider}/callback. It must match the
# callback registered at the provider. For a phone on the same LAN, use the
# computer's LAN address, e.g. http://192.168.1.20:8000.
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
# Frontend page that receives #access_token=...; leave empty to get the token as JSON (testing).
# e.g. AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
AUTH_REDIRECT_URL=
# Comma-separated verified e-mails that become admins on login.
ADMIN_EMAILS=
# POST /auth/dev-login: tokens for any user/role without OAuth. Local testing only!
AUTH_DEV_LOGIN=false
